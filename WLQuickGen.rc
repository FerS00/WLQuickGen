#include "resource.h"
#include <windows.h>

IDI_APPICON ICON "WLQuickGen.ico"

1 RT_MANIFEST "WLQuickGen.manifest"

// Keep in sync with project(VERSION) in CMakeLists.txt.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "FerS0"
            VALUE "FileDescription",  "WLQuickGen - WinLicense license generator"
            VALUE "FileVersion",      "1.1.0"
            VALUE "InternalName",     "WLQuickGen"
            VALUE "OriginalFilename", "WLQuickGen.exe"
            VALUE "ProductName",      "WLQuickGen"
            VALUE "ProductVersion",   "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
